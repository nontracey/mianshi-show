{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mianshi-show.local/contracts/knowledge-manifest.schema.json",
  "title": "Mianshi Show Knowledge Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "knowledgeBaseId", "contentVersion", "documents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "knowledgeBaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "source", "sha256"],
        "properties": {
          "documentId": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "deleted": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
